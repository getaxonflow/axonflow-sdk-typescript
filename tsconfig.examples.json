{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./.tsbuildinfo-examples",
    "baseUrl": ".",
    "paths": {
      "@axonflow/sdk": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "examples/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
